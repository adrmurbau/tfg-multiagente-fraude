# Copia este fichero como .env (no se versiona).
#
# El sistema es enteramente local y no necesita ninguna clave de API.
# La unica variable relevante desactiva la telemetria de CrewAI, que por
# defecto ofrece enviar trazas de ejecucion (prompts, respuestas del LLM y
# salidas de las herramientas) a app.crewai.com.
CREWAI_TRACING_ENABLED=false
